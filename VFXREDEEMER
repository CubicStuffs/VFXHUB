local function shineLine(text, colorKey, speed)
    speed = speed or 0.08
    consoleOrder += 1
    local color = consoleColors[colorKey] or C.txt
    local time = os.date("%H:%M:%S")
    local prefix = string.format("[%s] ", time)
    local line = new("TextLabel", {
        Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1,
        Text = prefix, Font=FBK, TextSize=14, TextColor3=Color3.fromRGB(255, 255, 255),
        TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true,
        LayoutOrder=consoleOrder, ZIndex=4,
    }, console)
    task.spawn(function()
        for i = 1, #text do
            if not line.Parent then return end
            line.Text = prefix .. text:sub(1, i)
            task.wait(speed)
        end
        task.wait(0.25)
        if not line.Parent then return end
        local grad = new("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, color),
                ColorSequenceKeypoint.new(0.35, color),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(0.65, color),
                ColorSequenceKeypoint.new(1.00, color),
            }),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0.00, 0.55),
                NumberSequenceKeypoint.new(0.35, 0.55),
                NumberSequenceKeypoint.new(0.50, 0.00),
                NumberSequenceKeypoint.new(0.65, 0.55),
                NumberSequenceKeypoint.new(1.00, 0.55),
            }),
            Rotation = 45,
        }, line)
        task.spawn(function()
            while line.Parent do
                grad.Offset = Vector2.new(-1, 0)
                TweenService:Create(grad, TweenInfo.new(1.1, Enum.EasingStyle.Linear), { Offset = Vector2.new(1, 0) }):Play()
                task.wait(1.5)
            end
        end)
    end)
    task.defer(function()
        if console and console.Parent then
            console.CanvasPosition = Vector2.new(0, math.max(0, console.AbsoluteCanvasSize.Y - console.AbsoluteSize.Y))
        end
    end)
    return line
end

