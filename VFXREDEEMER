local CUE_PREFIXES = {
    "the riddle is ", "ok riddle is ", "riddle is ",
    "the code is ", "ok code is ", "use this code ", "use code ", "code is ", "question is ",
}
local function stripCuePrefix(text)
    if not text or text == "" then return text end
    local l = text:lower()
    for _, p in ipairs(CUE_PREFIXES) do
        if l:sub(1, #p) == p then
            local stripped = text:sub(#p + 1):gsub("^%s+", ""):gsub("%s+$", "")
            if stripped ~= "" then return stripped end
        end
    end
    return text
end

