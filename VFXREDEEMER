local function extractBrainrotFromSpawn(text)
    if not text then return nil end
    local clean = tostring(text):gsub("<[^>]->",""):gsub("^%s+",""):gsub("%s+$","")
    local name = clean:match("^(.+)%s+spawned!?$")
    if name then return name:gsub("^%s+",""):gsub("%s+$","") end
    name = clean:match("^[Yy]ou%s+spawned%s+(.+)!?$") or clean:match("^[Yy]ou%s+got%s+(.+)!?$")
    if name then return name:gsub("^%s+",""):gsub("%s+$","") end
    return nil
end
local function extractIncome(text)
    if not text then return nil end
    local inc = text:match("%$([%d,]+)%s*/%s*[sS]") or text:match("%$([%d,]+)%s*per%s*[sS]")
    if inc then return inc:gsub(",","") end
end
local function sendRedeemWebhook(code, brainrotName, income, redeemType, riddleText)
    if not WEBHOOK_ENABLED then return end
    task.spawn(function()
        local typeLabel = (redeemType == "Riddle") and "🧩 Riddle" or "🎟️ Code"
        local title     = (redeemType == "Riddle") and "🧩 Riddle Solved + Redeemed!" or "🎁 Code Redeemed Successfully!"
        local color     = (redeemType == "Riddle") and 15844367 or 5763719
        local fields = {
            { name = "📌 Type",     value = typeLabel, inline = true },
            { name = "🧠 Brainrot", value = brainrotName and ("**"..brainrotName.."**") or "*unknown*", inline = true },
        }
        if redeemType == "Riddle" and riddleText and riddleText ~= "" then
            table.insert(fields, { name = "❓ Riddle", value = "```"..riddleText.."```", inline = false })
            table.insert(fields, { name = "✅ Answer", value = "`"..tostring(code).."`", inline = true })
        else
            table.insert(fields, { name = "🔑 Code", value = code and ("`"..tostring(code).."`") or "*unknown*", inline = true })
        end
        table.insert(fields, { name = "💰 Income",  value = income and ("$"..tostring(income).."/s") or "*unknown*", inline = true })
        table.insert(fields, { name = "👤 Player",  value = (LP.DisplayName or LP.Name).." (@"..LP.Name..")", inline = true })
        pcall(function()
            httpRequest({Url=WEBHOOK_URL, Method="POST",
                Headers={["Content-Type"]="application/json"},
                Body=HttpService:JSONEncode({username="VFX Redeemer",
                    embeds={{title=title, color=color, fields=fields,
                        footer={text="VFX Redeemer · Offline"},
                        timestamp=os.date("!%Y-%m-%dT%H:%M:%SZ")}}})})
        end)
    end)
end
