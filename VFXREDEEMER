local function handleSuccess(rawText)
    local now = os.clock()
    if now - scriptLoadedAt < STARTUP_GRACE then return end
    if not pendingCode and not lastRiddleAnswer then return end
    if now - lastSuccessfulRedeem < REDEEM_LOCKOUT then return end

    local key = normalizeMsgKey(rawText)
    if key == "" then return end
    if recentWebhooks[key] and (now - recentWebhooks[key]) < WEBHOOK_DEDUP_WINDOW then return end
    recentWebhooks[key] = now
    for k, t in pairs(recentWebhooks) do
        if now - t > WEBHOOK_DEDUP_WINDOW * 2 then recentWebhooks[k] = nil end
    end

    lastSuccessfulRedeem = now

    local isRiddle = (lastRiddleAnswer ~= nil) and pendingCode and
        tostring(lastRiddleAnswer):gsub("%s+",""):upper() == tostring(pendingCode):gsub("%s+",""):upper()

    local redeemedCode = pendingCode
    local riddleQ = lastRiddleText
    local redeemType = isRiddle and "Riddle" or "Code"
    local brainrotName = extractBrainrotFromSpawn(rawText)
    local income = extractIncome(rawText)

    pendingCode = nil
    lastRiddleText, lastRiddleAnswer = nil, nil
    redeemQueue = {}
    collectBuffer = {}

    if isRiddle then
        addConsoleLine("Riddle Redeemed Successfully", "riddle")
    elseif brainrotName then
        addConsoleLine("Code Redeemed Successfully · "..brainrotName, "success")
    else
        addConsoleLine("Code Redeemed Successfully", "success")
    end
    if brainrotName then
        addConsoleLine("   Brainrot: "..brainrotName..(income and (" · $"..income.."/s") or ""), "success")
    end

    sendRedeemWebhook(redeemedCode, brainrotName, income, redeemType, riddleQ)
end

local function handleRiddle(rawText)
    qText.Text = rawText
    qText.TextColor3 = C.txt

    if not riddleSolverEnabled then
        aText.Text = "Riddler is OFF"
        aText.TextColor3 = C.dim
        return
    end

    if not isActualRiddle(rawText) then return end

    addConsoleLine("Riddle: "..rawText, "riddle")
    aText.Text = "solving…"
    aText.TextColor3 = C.yellow

    local answer = solveOfflineRiddle(rawText)
    if answer and #answer > 0 then
        lastRiddleText = rawText
        lastRiddleAnswer = answer
        aText.Text = answer
        aText.TextColor3 = C.green
        addConsoleLine("📚 Answer: "..answer, "success")
        queueRedeem(answer)
        if autoCopyCode then pcall(setclipboard, answer) end
    else
        aText.Text = "No answer found"
        aText.TextColor3 = C.red
        addConsoleLine("⚠️ Could not solve riddle", "warn")
    end
end

local POSITIONS = {Top=true, Bottom=true, Center=true, Middle=true, Left=true, Right=true, TopRight=true, TopLeft=true, BottomRight=true, BottomLeft=true}
local function extractAnnouncementText(...)
    local packed = table.pack(...)
    local best
    for i = 1, packed.n do
        local v = packed[i]
        if typeof(v) == "string" then
            local text = stripRich(v)
            local lower = text:lower()
            if text ~= "" and not lower:find("sounds%.") and not lower:find("rbxassetid") and not POSITIONS[text] then
                if not best or #text > #best then best = text end
            end
        end
    end
    return stripRich(tostring(best or ((...) or "")))
end

local riddleCooldown = {}
local function onAnnouncement(...)
    local rawText = extractAnnouncementText(...)
    if rawText == "" then return end
    if isBlacklistedPhrase(rawText) then return end
    if os.clock() - lastSuccessfulRedeem < REDEEM_LOCKOUT then return end

    local lower = rawText:lower()
    -- ⭐ AUTO-ENABLE TRIGGERS
    if lower:find("code is", 1, true) or lower:find("the code is", 1, true) 
       or lower:find("use code", 1, true) or lower:find("use this code", 1, true)
       or lower:find("riddle is", 1, true)
       or isActualRiddle(rawText) then
        autoEnableOnCodeCue()
    end

    if listening and riddleSolverEnabled and rawText:find("%s") and not isCodeCueText(rawText) then
        local key = rawText:lower():gsub("%s+", " ")
        local now = os.clock()
        if not riddleCooldown[key] or (now - riddleCooldown[key]) > 3 then
            riddleCooldown[key] = now
            handleRiddle(rawText)
            return
        end
    end

    if listening then
        local wordCount = 0
        for _ in rawText:gmatch("%S+") do wordCount = wordCount + 1 end
        if wordCount > 1 then return end
        
        local words = tokenize(rawText)
        if #words == 0 then return end
        for _, w in ipairs(words) do
            collectBuffer[#collectBuffer + 1] = w
            local joined = table.concat(collectBuffer)
            aText.Text = string.upper(joined)
            aText.TextColor3 = C.txt
            queueRedeem(joined)
            if autoCopyCode then pcall(setclipboard, joined) end
        end
    end
end

local watchedObjects = {}
local function watchFB(obj, isInitialScan)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
    if obj:IsDescendantOf(SG) then return end
    if watchedObjects[obj] then return end
    watchedObjects[obj] = true
    local function handleText()
        local text = obj.Text or ""
        if text == "" then return end
        local lower = text:lower()
        if isInvalidText(lower) then pendingCode = nil; return end
        if isSuccessText(lower) then handleSuccess(text) end
    end
    if not isInitialScan then handleText() end
    obj:GetPropertyChangedSignal("Text"):Connect(handleText)
end
local function scanAll(obj)
    for _, d in ipairs(obj:GetDescendants()) do watchFB(d, true) end
end
