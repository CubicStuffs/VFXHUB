local function normalizeRiddleText(t)
    t = tostring(t or ""):lower()
    t = t:gsub("what's","what is"):gsub("whats","what is")
    t = t:gsub("who's","who is"):gsub("whos","who is")
    t = t:gsub("where's","where is"):gsub("wheres","where is")
    t = t:gsub("favourite","favorite"):gsub("colour","color")
    t = t:gsub("1st","first"):gsub("2nd","second"):gsub("3rd","third"):gsub("4th","fourth")
    t = t:gsub("5th","fifth"):gsub("6th","sixth"):gsub("7th","seventh"):gsub("8th","eighth")
    t = t:gsub("[^%w%s]"," "):gsub("%s+"," ")
    return t:match("^%s*(.-)%s*$") or ""
end
local function stemRiddleWord(w)
    w = tostring(w or ""):lower()
    if #w>4 and w:sub(-3)=="ing" then w=w:sub(1,-4) end
    if #w>4 and w:sub(-2)=="ed" then w=w:sub(1,-3) end
    if #w>4 and w:sub(-2)=="es" then w=w:sub(1,-3) end
    if #w>3 and w:sub(-1)=="s" then w=w:sub(1,-2) end
    local al={original="og",earliest="first",newest="latest",recent="latest",made="add",added="add",created="add",born="birth",birthday="birth",called="name"}
    return al[w] or w
end
local FILL={what=true,is=true,the=true,a=true,an=true,["do"]=true,does=true,did=true,you=true,are=true,was=true,were=true,am=true,i=true,my=true,me=true,we=true,our=true,of=true,to=true,["in"]=true,on=true,at=true,["and"]=true,["or"]=true,have=true,has=true,it=true,["for"]=true,how=true,where=true,who=true,when=true,which=true,can=true,s=true,will=true,would=true,could=true,please=true}
local function riddleWords(t)
    local w={}
    for word in normalizeRiddleText(t):gmatch("%w+") do
        local s=stemRiddleWord(word)
        if s~="" and not FILL[s] and not s:match("^%d+$") then w[s]=true end
    end
    if w.brainrot and w.god then w.brainrotgod=true end
    if w.brainrotgod then w.brainrot=true; w.god=true end
    return w
end
local function riddleMatch(msg, pat)
    local ph=normalizeRiddleText(pat)
    if msg:find(ph,1,true) then return true end
    if msg:gsub("%s+",""):find(ph:gsub("%s+",""),1,true) then return true end
    local ww,rr=riddleWords(pat),riddleWords(msg)
    local n=0
    for w in pairs(ww) do n+=1; if not rr[w] then return false end end
    return n>0
end

local function solveOfflineRiddle(message)
    if not message or message=="" then return nil end
    local working = tostring(message):lower()
    working = working:gsub("what's","what is"):gsub("whats","what is")
    working = working:gsub("who's","who is"):gsub("whos","who is")
    working = working:gsub("favourite","favorite"):gsub("colour","color")
    working = working:gsub("1st","first"):gsub("2nd","second"):gsub("3rd","third"):gsub("4th","fourth")
    working = working:gsub("5th","fifth"):gsub("6th","sixth"):gsub("7th","seventh"):gsub("8th","eighth")
    working = working:gsub("&"," and "):gsub(","," and "):gsub("%s+"," ")

    local pieces, current = {}, {}
    for word in working:gmatch("%S+") do
        if word == "and" then
            if #current > 0 then table.insert(pieces, table.concat(current, " ")); current = {} end
        else
            table.insert(current, word)
        end
    end
    if #current > 0 then table.insert(pieces, table.concat(current, " ")) end

    if #pieces <= 1 then
        local normalized = normalizeRiddleText(message)
        for _, e in ipairs(BRAINROT_KNOWLEDGE) do
            for _, pt in ipairs(e.p) do
                if riddleMatch(normalized, pt) then
                    local baseAnswer = e.a:gsub("%s+",""):upper()
                    local numsInAnswer = {}
                    for num in tostring(e.a):gmatch("%d+") do numsInAnswer[num] = true end
                    local suffix
                    for num in tostring(message):gmatch("%d+") do
                        if not numsInAnswer[num] then suffix = num end
                    end
                    if suffix and #suffix > 0 then return baseAnswer..suffix end
                    return baseAnswer
                end
            end
        end
        return nil
    end

    local answerParts = {}
    for _, piece in ipairs(pieces) do
        piece = piece:match("^%s*(.-)%s*$")
        if piece ~= "" then
            local numOnly = piece:match("^(%d+)$")
            if numOnly then
                table.insert(answerParts, numOnly)
            else
                local normalized = normalizeRiddleText(piece)
                local matched = false
                for _, e in ipairs(BRAINROT_KNOWLEDGE) do
                    for _, pt in ipairs(e.p) do
                        if riddleMatch(normalized, pt) then
                            table.insert(answerParts, e.a:gsub("%s+",""):upper())
                            matched = true; break
                        end
                    end
                    if matched then break end
                end
                if not matched then return nil end
            end
        end
    end
    if #answerParts > 0 then return table.concat(answerParts) end
    return nil
end

local function isActualRiddle(text)
    if not text or text == "" then return false end
    local l = text:lower():gsub("%s+", " ")
    local hasQuestion = l:find("%?")
    local startsWithQ = l:match("^%s*(what%s+is)") or l:match("^%s*(whats)") or l:match("^%s*(who)") 
                     or l:match("^%s*(where)") or l:match("^%s*(when)") or l:match("^%s*(how%s+many)")
                     or l:match("^%s*(which)") or l:match("^%s*(my%s+name)") or l:match("^%s*(the%s+word)")
    local hasKeyword = l:find("og") or l:find("mutation") or l:find("machine") or l:find("brainrot")
                    or l:find("color") or l:find("colour") or l:find("favorite") or l:find("fav")
                    or l:find("name") or l:find("age") or l:find("birthday") or l:find("country")
                    or l:find("rarity") or l:find("trait") or l:find("sammy") or l:find("developer")
                    or l:find("game") or l:find("secret") or l:find("world cup") or l:find("admin")
                    or l:find("hydra") or l:find("lightning") or l:find("fight") or l:find("roblox")
    local wordCount = 0
    for _ in l:gmatch("%S+") do wordCount = wordCount + 1 end
    if wordCount < 2 then return false end
    if not (hasQuestion or startsWithQ) then return false end
    if not hasKeyword then return false end
    return true
end

