local radiusFolder = new("Folder", { Name = "__VFXAutoBuyRadius" }, workspace)
local radiusModel  = new("Model", { Name = "GroundHalo" }, radiusFolder)
radiusModel.WorldPivot = CFrame.new()
local radiusRingBuilt, radiusRingEnabled = false, false
local ensureRadiusRing, setRadiusRingEnabled
do
    local radiusAnchor, attachments, beams = nil, {}, {}
    local LAYERS = { { name="PurpleOutline", width=2.35, color=Color3.fromRGB(200,60,220), transparency=0.06, emission=0.80 } }
    ensureRadiusRing = function()
        if radiusRingBuilt then return end
        radiusRingBuilt = true
        radiusAnchor = new("Part", { Name="RadiusAnchor", Anchored=true, CanCollide=false, CanTouch=false, CanQuery=false, CastShadow=false, Transparency=1, Size=Vector3.new(0.1,0.1,0.1) }, radiusModel)
        for li, spec in ipairs(LAYERS) do
            attachments[li] = {}
            for i = 1, 4 do
                local angle = ((i-1)/4) * 2 * math.pi
                local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
                attachments[li][i] = new("Attachment", { Name=spec.name.."P"..i, Position=radial*autoBuyRadius }, radiusAnchor)
            end
            for i = 1, 4 do
                local beam = new("Beam", { Name=spec.name..i, Attachment0=attachments[li][i], Attachment1=attachments[li][(i%4)+1], FaceCamera=false, Segments=32, Width0=spec.width, Width1=spec.width, Color=ColorSequence.new(spec.color), Transparency=NumberSequence.new(spec.transparency), LightEmission=spec.emission, LightInfluence=0, Enabled=false }, radiusAnchor)
                beams[#beams+1] = beam
            end
        end
    end
    setRadiusRingEnabled = function(value)
        if radiusRingEnabled == value then return end
        radiusRingEnabled = value
        for _, b in ipairs(beams) do b.Enabled = value end
    end
end

