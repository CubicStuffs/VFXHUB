local getupvalues = _getupvalues or (type(debug) == "table" and rawget(debug, "getupvalues")) or nil
local getconns    = _getconnections or (type(debug) == "table" and rawget(debug, "getconnections")) or nil
local setupv      = _setupvalue or (type(debug) == "table" and rawget(debug, "setupvalue")) or nil
local Rem = {}
do
    local function getRemotesFromFn(fn)
        if not getupvalues then return {} end
        local ok, ups = pcall(getupvalues, fn)
        local out = {}
        if ok and ups then
            for _, v in pairs(ups) do
                if typeof(v) == "Instance" and (v:IsA("RemoteEvent") or v:IsA("RemoteFunction") or v:IsA("UnreliableRemoteEvent")) and v.Parent == Net then table.insert(out, v) end
            end
        end
        return out
    end
    function Rem.resolveNotify()
        local ctrl = ReplicatedStorage:FindFirstChild("Controllers")
        ctrl = ctrl and ctrl:FindFirstChild("NotificationController", true)
        if ctrl then
            local ok, mod = pcall(require, ctrl)
            if ok and type(mod) == "table" and type(mod.Start) == "function" then
                local r = getRemotesFromFn(mod["Start"])[1]
                if r then return r end
            end
        end
        local gi = debug and (debug.getinfo or debug.info)
        if getgc and gi and getconnections and Net then
            for _, d in ipairs(Net:GetDescendants()) do
                if d:IsA("RemoteEvent") then
                    local ok, cs = pcall(getconnections, d.OnClientEvent)
                    if ok and type(cs) == "table" then
                        for _, c in ipairs(cs) do
                            local f, fn = pcall(function() return c.Function end)
                            if f and type(fn) == "function" then
                                local i, info = pcall(gi, fn)
                                if i and tostring(info.short_src or info.source or ""):find("NotificationController", 1, true) then return d end
                            end
                        end
                    end
                end
            end
        end
        return nil
    end
end

