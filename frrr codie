        if type(_syn) == "table" and type(_syn.request) == "function" then local ok, res = pcall(_syn.request, opts); if ok and res then return true, res end end
        local ok, res = pcall(function() return HttpService:RequestAsync(opts) end)
        if ok and res then return true, res end
        return false, "no-http-method"
    end
    function Webhook.sendRedeem(code, brainrotName, income, redeemType, riddleText)
