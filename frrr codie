            if not isStop(sub) and not isStop(obj) and not isAdjective(obj) and obj ~= "is" then if addFact("FAVORITE_"..sub, obj, "favorite-short") then pushLearned(learned, "FAVORITE_"..up(sub), up(obj)) end end
        end
        for sub, obj in l:gmatch("my%s+favourite%s+(%a+)%s+([%a%d]+)") do
            if not isStop(sub) and not isStop(obj) and not isAdjective(obj) and obj ~= "is" then if addFact("FAVORITE_"..sub, obj, "favorite-short") then pushLearned(learned, "FAVORITE_"..up(sub), up(obj)) end end
