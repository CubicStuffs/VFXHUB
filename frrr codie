        local ww,rr=riddleWords(pat),riddleWords(msg)
        local n=0
        for w in pairs(ww) do
            n = n + 1
            if not rr[w] then return false end
        end
        if n == 1 then
            for w in pairs(rr) do
                if not ww[w] then return false end
            end
        end
        return n>0
    end
    local function findFirstMatch(txt)
        local normalized = normalizeRiddleText(txt)
        for _, e in ipairs(BRAINROT_KNOWLEDGE) do
            for _, pt in ipairs(e.p) do
                if riddleMatch(normalized, pt) then
                    return e.a:gsub("%s+",""):upper(), e.a
                end
            end
        end
        return nil, nil
    end
    function Riddle.solve(message)
        if not message or message=="" then return nil end
        local working = tostring(message):lower()
        working = working:gsub("what's","what is"):gsub("whats","what is")
        working = working:gsub("who's","who is"):gsub("whos","who is")
        working = working:gsub("favourite","favorite"):gsub("colour","color")
        working = working:gsub("1st","first"):gsub("2nd","second"):gsub("3rd","third"):gsub("4th","fourth")
        working = working:gsub("5th","fifth"):gsub("6th","sixth"):gsub("7th","seventh"):gsub("8th","eighth")
        working = working:gsub("&"," and "):gsub(","," and ")
        working = working:gsub("%s+plus%s+", " and "):gsub("%s+also%s+", " and ")
        working = working:gsub("%s+"," ")
        local pieces = {}
        local andPieces, cur = {}, {}
        for word in working:gmatch("%S+") do
            if word == "and" then
                if #cur > 0 then table.insert(andPieces, table.concat(cur, " ")); cur = {} end
            else
                table.insert(cur, word)
            end
        end
        if #cur > 0 then table.insert(andPieces, table.concat(cur, " ")) end
        for _, piece in ipairs(andPieces) do
            local p = piece:match("^%s*(.-)%s*$") or ""
            if p ~= "" then
                local subparts = {}
                local buf = {}
                for word in p:gmatch("%S+") do
                    if word == "my" and #buf > 0 then
                        table.insert(subparts, table.concat(buf, " "))
                        buf = { word }
                    else
                        table.insert(buf, word)
                    end
                end
                if #buf > 0 then table.insert(subparts, table.concat(buf, " ")) end
                for _, sp in ipairs(subparts) do
                    sp = sp:match("^%s*(.-)%s*$") or ""
                    if sp ~= "" then table.insert(pieces, sp) end
                end
            end
        end
        if #pieces <= 1 then
            local baseAnswer, originalAnswer = findFirstMatch(message)
            if not baseAnswer then return nil end
            local numsInAnswer = {}
            local answerHasDigits = false
            for num in tostring(originalAnswer):gmatch("%d+") do
                numsInAnswer[num] = true
                answerHasDigits = true
            end
            if answerHasDigits then return baseAnswer end
            local suffix
            for num in tostring(message):gmatch("%d+") do
                if not numsInAnswer[num] then suffix = num end
            end
            if suffix and #suffix > 0 then return baseAnswer..suffix end
            return baseAnswer
        end
        local answerParts = {}
        local allOk = true
        for _, piece in ipairs(pieces) do
            piece = piece:match("^%s*(.-)%s*$")
            if piece ~= "" then
                local numOnly = piece:match("^(%d+)$")
                if numOnly then
                    table.insert(answerParts, numOnly)
                else
                    local a = findFirstMatch(piece)
                    if not a then allOk = false; break end
                    table.insert(answerParts, a)
                end
            end
        end
        if allOk and #answerParts > 0 then return table.concat(answerParts) end
        -- ⭐ FALLBACK: agar compound fail ho, toh full message mein koi bhi known pattern dhoondo
        local fallback = findFirstMatch(message)
        if fallback then return fallback end
        return nil
    end
