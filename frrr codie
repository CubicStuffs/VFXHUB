local POSITIONS = {Top=true, Bottom=true, Center=true, Middle=true, Left=true, Right=true, TopRight=true, TopLeft=true, BottomRight=true, BottomLeft=true}
local function extractAnnouncementText(...)
    local packed = table.pack(...)
    local best
    for i = 1, packed.n do
        local v = packed[i]
        if typeof(v) == "string" then
            local text = Util.stripRich(v)
            local lower = text:lower()
            if text ~= "" and not lower:find("sounds%.") and not lower:find("rbxassetid") and not POSITIONS[text] then
                if not best or #text > #best then best = text end
            end
        end
    end
    return Util.stripRich(tostring(best or ((...) or "")))
end

local riddleCooldown = {}
local function onAnnouncement(...)
    local rawText = extractAnnouncementText(...)
    if rawText == "" then return end
    -- ⭐ Early skip: sold out / expired / invalid codes ko memory mein mat daalo
    do
        local _ll = tostring(rawText):lower()
        if _ll:find("sold out", 1, true)
           or _ll:find("out of stock", 1, true)
           or _ll:find("no longer available", 1, true)
           or _ll:find("already redeemed", 1, true)
           or _ll:find("already used", 1, true)
           or _ll:find("code expired", 1, true)
           or _ll:find("redeem limit", 1, true)
           or _ll:find("limit reached", 1, true)
           or _ll:find("not available", 1, true)
           or _ll:find("unavailable", 1, true) then
            return
        end
    end
    if not Chk.isNoiseText(rawText) then
        local l = tostring(rawText):lower()
        local qCount = 0
        if l:find("%f[%a]which%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]where%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]what%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]who%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]when%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]why%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]how%f[%A]") then qCount = qCount + 1 end
        local isQuestion = qCount >= 2 or rawText:find("%?") ~= nil
        if not isQuestion and not l:find("spawned!") and not l:find("has spawned") and not l:find("code redeemed") and not l:find("you got") and not l:find("you received") and not l:find("congratulations") then
            local learned = MemoryBank.feed(rawText)
            if learned and #learned > 0 then
                for _, kv in ipairs(learned) do typewriterLine("🧠 Memorizing "..kv.k.." = "..kv.v, "mem", 0.012) end
                refreshMemPill()
            end
        end
    end
    if Chk.isBlacklisted(rawText) then return end
    if os.clock() - lastSuccessfulRedeem < REDEEM_LOCKOUT then return end
    local lower = rawText:lower()
    if lower:find("code is", 1, true) or lower:find("the code is", 1, true) or lower:find("use code", 1, true) or lower:find("use this code", 1, true) or lower:find("riddle is", 1, true) or lower:find("the riddle is", 1, true) or lower:find("ok code is", 1, true) or lower:find("question is", 1, true) or Riddle.isActual(rawText) then
        autoEnableOnCodeCue()
    end
    local stripped = Util.stripCuePrefix(rawText)
    if stripped ~= "" and stripped ~= rawText then
        addConsoleLine("Stripped cue: '"..rawText.."' → '"..stripped.."'", "system")
        rawText = stripped
        lower = rawText:lower()
    end
    if listening and riddleSolverEnabled and rawText:find("%s") and not Chk.isCodeCue(rawText) then
        local key = rawText:lower():gsub("%s+", " ")
        local now = os.clock()
        if not riddleCooldown[key] or (now - riddleCooldown[key]) > 3 then
            riddleCooldown[key] = now
            handleRiddle(rawText)
            return
        end
    end
    if listening then
        local wordCount = 0
        for _ in rawText:gmatch("%S+") do wordCount = wordCount + 1 end
        if wordCount > 1 then return end
        local words = Util.tokenize(rawText)
        if #words == 0 then return end
        for _, w in ipairs(words) do
            collectBuffer[#collectBuffer + 1] = w
            local joined = table.concat(collectBuffer)
            aText.Text = string.upper(joined)
            aText.TextColor3 = C.txt
            queueRedeem(joined)
            if autoCopyCode and _setclipboard then pcall(_setclipboard, joined) end
        end
    end
end

