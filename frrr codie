local AnimH = { settingsOpen = false, collapsed = false }
do
    local function attachRipple(btn)
        btn.MouseButton1Down:Connect(function()
            local r = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = (btn.ZIndex or 1) + 20,
            }, btn)
            corner(r)
            local maxSize = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.2
            TweenService:Create(r, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Size = UDim2.fromOffset(maxSize, maxSize), BackgroundTransparency = 1}):Play()
            task.delay(0.6, function() if r and r.Parent then r:Destroy() end end)
        end)
    end
    function AnimH.button(btn, opts)
        opts = opts or {}
        local normalColor = opts.normal or btn.BackgroundColor3
        local hoverColor = opts.hover or Color3.new(math.min(1, normalColor.R + 0.10), math.min(1, normalColor.G + 0.06), math.min(1, normalColor.B + 0.12))
        local s = btn:FindFirstChildOfClass("UIScale") or new("UIScale", {Scale = 1}, btn)
        local st = btn:FindFirstChildOfClass("UIStroke")
        btn.MouseEnter:Connect(function() tween(btn, 0.15, {BackgroundColor3 = hoverColor}); if st then tween(st, 0.15, {Transparency = 0.1}) end end)
        btn.MouseLeave:Connect(function() tween(btn, 0.2, {BackgroundColor3 = normalColor}); TweenService:Create(s, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play(); if st then tween(st, 0.2, {Transparency = 0.5}) end end)
        btn.MouseButton1Down:Connect(function() TweenService:Create(s, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {Scale = 0.93}):Play() end)
        btn.MouseButton1Up:Connect(function() TweenService:Create(s, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play() end)
        attachRipple(btn)
    end
    function AnimH.card(card)
        local baseColor = card.BackgroundColor3
        local st = card:FindFirstChildOfClass("UIStroke")
        local scale = card:FindFirstChildOfClass("UIScale") or new("UIScale", {Scale = 1}, card)
        card.MouseEnter:Connect(function()
            tween(card, 0.2, {BackgroundColor3 = Color3.new(math.min(1, baseColor.R + 0.06), math.min(1, baseColor.G + 0.04), math.min(1, baseColor.B + 0.09))})
            if st then tween(st, 0.2, {Transparency = 0.05, Color = C.accent2}) end
            TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1.02}):Play()
        end)
        card.MouseLeave:Connect(function()
            tween(card, 0.25, {BackgroundColor3 = baseColor})
            if st then tween(st, 0.25, {Transparency = 0.35, Color = C.cardBorder}) end
            TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end)
    end
    function AnimH.pulse(obj, prop, low, high, dur)
        dur = dur or 0.9
        task.spawn(function()
            while obj and obj.Parent do
                TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {[prop] = high}):Play()
                task.wait(dur)
                if not obj or not obj.Parent then return end
                TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {[prop] = low}):Play()
                task.wait(dur)
            end
        end)
    end
end

